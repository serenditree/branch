{
  "index": {
    "max_ngram_diff": 3
  },
  "analysis": {
    "tokenizer": {
      "ngram_tokenizer": {
        "type": "ngram",
        "min_gram": 3,
        "max_gram": 6,
        "token_chars": [
          "letter",
          "digit"
        ]
      }
    },
    "analyzer": {
      "default": {
        "type": "standard"
      },
      "ngram_analyzer": {
        "tokenizer": "ngram_tokenizer",
        "filter": [
          "lowercase"
        ]
      }
    }
  }
}
